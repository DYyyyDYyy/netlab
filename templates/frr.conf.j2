! generated by netlab from IPAM - do not edit
frr defaults traditional
hostname {{ hostname }}
log stdout informational
service integrated-vtysh-config
!
{% for lo in loopbacks %}
interface lo
 ip address {{ lo.ip }}/32
exit
!
{% endfor %}
{% for i in transit %}
interface {{ i.name }}
 description {{ i.subnet.name }}
 ip ospf network point-to-point
 ip ospf hello-interval 1
 ip ospf dead-interval 4
exit
!
{% endfor %}
router ospf
 ospf router-id {{ router_id }}
{% for i in passive %}
 passive-interface {{ i.name }}
{% endfor %}
{% for i in ospf %}
 network {{ i.subnet.prefix }} area 0
{% endfor %}
{% if upstream %}
 default-information originate always
{% endif %}
exit
!
{% if upstream %}
ip route 0.0.0.0/0 {{ upstream }}
!
{% endif %}

#!/usr/sbin/nft -f
# generated by netlab from IPAM for {{ hostname }} - do not edit
flush ruleset

define WAN_IF = "{{ wan.name }}"
define WAN_IP = {{ wan.ip }}
define INSIDE = { {{ inside | join(", ") }} }

table inet filter {
    chain input {
        type filter hook input priority filter; policy drop;
        iif "lo" accept
        ct state established,related accept
        ct state invalid drop
        ip protocol 89 accept comment "ospf"
        ip protocol icmp accept
        iifname != $WAN_IF ip saddr $INSIDE accept
        counter comment "input default deny"
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        ct state established,related accept
        ct state invalid drop
        # inside <-> inside transit through the border
        iifname != $WAN_IF oifname != $WAN_IF accept
        # inside -> internet
{% if policy.allow_out_icmp %}
        iifname != $WAN_IF oifname $WAN_IF ip saddr $INSIDE ip protocol icmp accept
{% endif %}
{% if policy.allow_out_tcp %}
        iifname != $WAN_IF oifname $WAN_IF ip saddr $INSIDE tcp dport { {{ policy.allow_out_tcp | join(", ") }} } accept
{% endif %}
{% if policy.allow_out_udp %}
        iifname != $WAN_IF oifname $WAN_IF ip saddr $INSIDE udp dport { {{ policy.allow_out_udp | join(", ") }} } accept
{% endif %}
        # internet -> inside: only published services (DNAT)
        iifname $WAN_IF ct status dnat accept
        counter comment "forward default deny"
    }
}

table ip nat {
    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;
{% for pf, ip in forwards %}
        iifname $WAN_IF ip daddr $WAN_IP {{ pf.proto }} dport {{ pf.external_port }} dnat to {{ ip }}:{{ pf.target_port }} comment "publish {{ pf.target }}"
{% endfor %}
    }

    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        # PAT: many inside hosts share the single WAN address
        oifname $WAN_IF ip saddr $INSIDE masquerade
    }
}
